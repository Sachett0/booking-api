{
  "name": "booking-api",
  "version": "0.1.0",
  "description": "Booking API that prevents double bookings, even under concurrent requests.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
